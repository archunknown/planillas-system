# Requerido por NextAuth v5 en todos los entornos (incluyendo development).
# Genera un secreto seguro con: openssl rand -base64 32
AUTH_SECRET=

# URL de conexión a PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/planillas_db

# Admin inicial (usado por prisma/seed.ts)
# Si no se definen, el seed usa valores por defecto solo para desarrollo.
SEED_ADMIN_EMAIL=admin@estudio.pe
SEED_ADMIN_PASSWORD=
